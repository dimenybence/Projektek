<h1 class="mb-4">Learnify</h1>

<div class="container">
  <div class="row">
    <!-- Bejelentkezési űrlap -->
    <div class="col-md-6 pe-md-3">
      <h2>Bejelentkezés</h2>
      <%= form_with url: login_path, method: :post, local: true do |form| %>
        <div class="mb-3">
          <%= form.label :email, class: "form-label" %>
          <%= form.email_field :email, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :password, "Jelszó", class: "form-label" %>
          <%= form.password_field :password, class: "form-control" %>
        </div>

        <%= form.submit "Bejelentkezés", class: "btn btn-primary mt-2" %>
      <% end %>
    </div>

    <!-- Regisztrációs űrlap -->
    <div class="col-md-6 ps-md-3">
      <h2>Regisztráció</h2>
      <%= form_with model: @user, url: register_path, method: :post, local: true do |form| %>
        <div class="mb-3">
          <%= form.label :username, "Felhasználónév", class: "form-label" %>
          <%= form.text_field :username, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :email, "Email-cím", class: "form-label" %>
          <%= form.email_field :email, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :password, "Jelszó", class: "form-label" %>
          <%= form.password_field :password, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :password_confirmation, "Jelszó megerősítése", class: "form-label" %>
          <%= form.password_field :password_confirmation, class: "form-control" %>
        </div>

        <%= form.submit "Regisztráció", class: "btn btn-success mt-2" %>
      <% end %>
    </div>
  </div>
</div>